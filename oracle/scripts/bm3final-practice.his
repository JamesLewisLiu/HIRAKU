# beatmania III The Final: boot -> attract -> 2 coins -> mode select -> the
# practice stage ("Instant Love", DJ KONAMI tutorial), keys pressed in a fixed
# pattern so the judge, keysounds and BGA hit/miss hooks all fire.
# Reference trace for M2-M5. Deterministic: same inputs, same frames.
game bm3final

watch measure u32 0x80103674        # bar counter (high half = bar)
watch scene   u32 0x802566dc        # BGA scene id
watch keymask u32 0x802566c0        # BGA key mask / judge state
watch objs    u32 0x801000cc        # BGA live-object list head
hash  kernel  0x81fe0000 0x82000000 # kernel stack + initial frames
hash  sda     0x80100000 0x80110000 # small-data area, engine globals

at 3600 mark coin
at 3600 press "Coin 1" 8
at 3630 press "Coin 1" 8
at 3700 press "1 Player Start" 12
at 4000 mark mode-select
at 4000 press "P1 Button 1" 8       # mode select: confirm (kobako)
at 4400 press "P1 Button 1" 8       # sound select: confirm (practice stage)
at 4700 press "P1 Button 1" 8
at 4800 mark song

at 5400 dump sda 0x80100000 0x80110000
at 9000 dump sda 0x80100000 0x80110000
from 3600 every 300 snap
at 5000 press "P1 Button 1" 4
at 5020 press "P1 Button 2" 4
at 5040 press "P1 Button 3" 4
at 5060 press "P1 Button 4" 4
at 5080 press "P1 Button 5" 4
