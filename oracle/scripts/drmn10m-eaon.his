# DrumMania 10th Mix with the network unit, from drmn10m-npu: test mode, NETWORK OPTIONS >
# e-AMUSEMENT OPTIONS, e-AMUSEMENT ON (hold Start, Select R), SAVE AND EXIT. It is OFF by default.
game drmn10m

at 12600 press "Test" 8
# the main menu: NETWORK OPTIONS is the eleventh item
at 13000 press "Select R" 8
at 13060 press "Select R" 8
at 13120 press "Select R" 8
at 13180 press "Select R" 8
at 13240 press "Select R" 8
at 13300 press "Select R" 8
at 13360 press "Select R" 8
at 13420 press "Select R" 8
at 13480 press "Select R" 8
at 13540 press "Select R" 8
at 13600 press "Select R" 8
at 13660 press "1 Player Start" 8
# NETWORK OPTIONS > e-AMUSEMENT OPTIONS: e-AMUSEMENT ON
at 13860 press "1 Player Start" 8
at 14160 hold "1 Player Start"
at 14180 press "Select R" 8
at 14210 release "1 Player Start"
at 14220 snap
# ON adds ee'MALL, SHOP NAME SETTINGS and PREFECTURE: SAVE AND EXIT is five down
at 14240 press "Select R" 8
at 14300 press "Select R" 8
at 14360 press "Select R" 8
at 14420 press "Select R" 8
at 14480 press "Select R" 8
at 14540 snap
at 14550 press "1 Player Start" 8
at 14850 snap
at 14860 quit
