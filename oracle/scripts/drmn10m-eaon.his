# DrumMania 10th Mix with the network unit, from drmn10m-npu: test mode, NETWORK OPTIONS >
# e-AMUSEMENT OPTIONS, e-AMUSEMENT ON (hold Start, Select R), SAVE AND EXIT. It is OFF by default.
game drmn10m

at 11100 press "Test" 8
# the main menu: NETWORK OPTIONS is the eleventh item
at 11500 press "Select R" 8
at 11560 press "Select R" 8
at 11620 press "Select R" 8
at 11680 press "Select R" 8
at 11740 press "Select R" 8
at 11800 press "Select R" 8
at 11860 press "Select R" 8
at 11920 press "Select R" 8
at 11980 press "Select R" 8
at 12040 press "Select R" 8
at 12100 press "Select R" 8
at 12160 press "1 Player Start" 8
# NETWORK OPTIONS > e-AMUSEMENT OPTIONS: e-AMUSEMENT ON
at 12360 press "1 Player Start" 8
at 12660 hold "1 Player Start"
at 12680 press "Select R" 8
at 12710 release "1 Player Start"
at 12720 snap
# ON adds ee'MALL, SHOP NAME SETTINGS and PREFECTURE: SAVE AND EXIT is five down
at 12740 press "Select R" 8
at 12800 press "Select R" 8
at 12860 press "Select R" 8
at 12920 press "Select R" 8
at 12980 press "Select R" 8
at 13040 snap
at 13050 press "1 Player Start" 8
at 13350 snap
at 13360 quit
