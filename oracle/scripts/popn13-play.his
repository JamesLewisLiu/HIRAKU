# pop'n music 13 Carnival (Konami Python 1): boot -> 2 coins -> red starts -> ENJOY (red, once its
# mode select has settled) -> button select (blue right, red: 9 buttons) -> song select (red, red) ->
# the song (the Anpanman march, long), played with one button every 10 frames -> stage 2's song select.
game popn13

at 3200 press "Coin 1" 8
at 3240 press "Coin 1" 8
at 3400 press "P1 Button 5" 8     # red: start
at 4500 press "P1 Button 5" 10    # mode select: ENJOY
at 4800 press "P1 Button 6" 10    # button select: blue right, to 9 buttons
at 4900 press "P1 Button 5" 10    # ... and red
at 5700 press "P1 Button 5" 10    # song select: this song
at 5900 press "P1 Button 5" 10    # confirm
